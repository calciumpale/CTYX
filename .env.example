# Configure these as server runtime variables, never as NEXT_PUBLIC values.
# Local Cloudflare runtime values belong in ignored .dev.vars.
MODEL_API_KEY=
MODEL_BASE_URL=
MODEL_NAME=
# Optional server-side fallback for MinerU cloud PDF parsing.
MINERU_API_TOKEN=
# 32-byte encryption key represented as 64 hexadecimal characters; server only.
# Keep stable: existing saved API keys cannot be read after changing this value.
CONFIG_ENCRYPTION_KEY=
# Self-hosted voice gateway. Same secret on the Python server (>=32 bytes).
VOICE_GATEWAY_URL=
VOICE_GATEWAY_SECRET=

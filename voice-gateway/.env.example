# The same server-only secret is configured in the Worker's VOICE_GATEWAY_SECRET.
# Generate once with: openssl rand -hex 32
VOICE_GATEWAY_SECRET=
ALLOWED_ORIGINS=https://your-private-site.example
ASR_MODEL_DIR=/models/asr
ASR_NUM_THREADS=2
ASR_WORKERS=2
ASR_ENDPOINT_SILENCE=0.7
MAX_SESSIONS=4

# This base includes /v1. Only the gateway sees provider credentials.
TTS_BASE_URL=http://kokoro:8880/v1
TTS_MODEL=kokoro
TTS_API_KEY=
TTS_STYLE=openai
TTS_VOICES=[{"id":"zf_xiaobei","name":"晓贝","lang":"zh-CN","description":"Kokoro中文音色；需服务端已安装"},{"id":"zm_yunxi","name":"云希","lang":"zh-CN","description":"Kokoro中文音色；需服务端已安装"}]
TTS_DEFAULT_VOICE=zf_xiaobei

# For a Qwen3-TTS OpenAI-compatible deployment emitting raw 24kHz PCM:
# TTS_BASE_URL=http://qwen-tts:8000/v1
# TTS_MODEL=Qwen/Qwen3-TTS-12Hz-0.6B-CustomVoice
# TTS_STYLE=qwen
# TTS_VOICES=[{"id":"Vivian","name":"Vivian","lang":"zh-CN"}]
# TTS_DEFAULT_VOICE=Vivian
# Qwen mode sends stream=true and stream_format=audio; enable async_chunk
# in the vLLM-Omni deployment configuration, not in the HTTP request body.
# It omits speed because the streaming provider does not implement it.
